{
	"name": "tralsys/bids-rtc-backend",
	"description": "BIDS WebRTC Signaling API Backend",
	"type": "project",
	"license": "MIT",
	"authors": [
		{
			"name": "Tralsys",
			"homepage": "https://github.com/Tralsys"
		}
	],
	"require": {
		"php": "^8.3",
		"slim/slim": "^4.14",
		"slim/psr7": "^1.7",
		"php-di/slim-bridge": "^3.4",
		"monolog/monolog": "^3.8",
		"neomerx/cors-psr7": "^3.0",
		"ramsey/uuid": "^4.7",
		"kreait/firebase-php": "^7.16",
		"symfony/cache": "^7.0",
		"zircote/swagger-php": "^4.11"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5",
		"squizlabs/php_codesniffer": "^3.10",
		"overtrue/phplint": "^9.4"
	},
	"autoload": {
		"psr-4": {
			"BidsRtc\\Backend\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"BidsRtc\\Backend\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit",
		"phpcs": "phpcs",
		"phplint": "phplint ./src --exclude=vendor",
		"generate-openapi": "php bin/generate-openapi.php"
	},
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"php-http/discovery": true
		}
	}
}
